# Copy to .env and fill in real values. Never commit .env.
# Set DJANGO_ENV=production on the live server to enable secure
# cookies, SSL redirect, HSTS, and locked-down CORS.

DJANGO_ENV=development
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=quality
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DEFAULTS_FILE=/etc/mysql/my.cnf

REDIS_URL=redis://127.0.0.1:6379/1

QC_API_KEY=
QC_API_REFRESH_TOKEN=

# SurveyGenius secondary DB (used by supercheck views)
SURVEYGENIUS_DB_HOST=127.0.0.1
SURVEYGENIUS_DB_PORT=9000
SURVEYGENIUS_DB_USER=root
SURVEYGENIUS_DB_PASSWORD=
SURVEYGENIUS_DB_NAME=surveygeniusdb

# AXISMYINDIA secondary DB (used by images/videos download)
AXISMYINDIA_DB_HOST=127.0.0.1
AXISMYINDIA_DB_USER=root
AXISMYINDIA_DB_PASSWORD=
AXISMYINDIA_DB_NAME=AXISMYINDIA

# Comma-separated list, required when DJANGO_ENV=production
CORS_ALLOWED_ORIGINS=
